# Docker Compose. Copy to .env and choose private, independent secrets.
# Use URL-safe characters for POSTGRES_PASSWORD, or URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-private-db-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-private-admin-password
CHECKOUT_SECRET=replace-with-64-random-hex-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-separate-random-secret
APP_ORIGIN=http://localhost
