{
  "name": "aura-studio-backend",
  "version": "1.0.0",
  "description": "Node.js REST API Backend for Aura Studio & Costume Rental",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/domain.test.cjs test/integration.test.cjs test/webhook-gateway.test.cjs",
    "payment:gateway": "node scripts/webhook-gateway.cjs",
    "test:local": "node --env-file=../.local/backend.env scripts/test-local.cjs"
  },
  "keywords": [
    "express",
    "nodejs",
    "photobooth",
    "studio",
    "costume-rental"
  ],
  "author": "Aura Studio Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "10.3.1",
    "pg": "^8.23.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "qs": "6.17.1"
  }
}
